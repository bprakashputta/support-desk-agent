# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# AGENT_MODEL=claude-haiku-5-5
# USER_SIM_MODEL=claude-haiku-5-5
# GUARD_MODE=enforce              # enforce = code-enforced policy; audit = prompt-only, violations logged
# APPROVAL_THRESHOLD_USD=1000     # refunds above this wait for a human in the console
# SPEND_CAP_USD=5.00              # hard cap; calls are refused once the ledger reaches it
# LOG_LEVEL=INFO
